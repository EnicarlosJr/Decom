# Django email backend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server
EMAIL_HOST=smtp.seu-servidor.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email-ou-usuario
EMAIL_HOST_PASSWORD=sua-senha-ou-senha-de-app
EMAIL_USE_TLS=true

# Sender and generated invitation links
DEFAULT_FROM_EMAIL=nao-responda@decom.ufvjm.edu.br
SITE_BASE_URL=http://localhost:8000

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret
GOOGLE_OAUTH_PROJECT_ID=seu-project-id
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/accounts/social/google/login/callback/
